# ============================================================
#  Maa Jagadhatri Pooja, Saidapur — environment variables
#  ------------------------------------------------------------
#  Copy this file to .env and fill in your real values.
#  .env is git-ignored and NEVER committed to the repository.
#
#  For local development: install Vercel CLI, then run:
#    vercel dev
#  The proxy will be available at http://localhost:3000/api/chat
#
#  For production (Vercel):
#    Set GROQ_API_KEY in the Vercel dashboard under
#    Project → Settings → Environment Variables
# ============================================================

# Your Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# (Optional) Override the default model
GROQ_MODEL=llama-3.3-70b-versatile

# Site info
SITE_NAME=Maa Jagadhatri Pooja, Saidapur
SITE_URL=https://maajagadhatrisaidapur.vercel.app
